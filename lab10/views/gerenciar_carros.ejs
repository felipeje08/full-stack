<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">

    <title>Gerenciar Carros</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>Gerenciar Carros</h1>

    <a
        class="botao"
        href="/cadastrar_carro"
    >
        Novo Carro
    </a>

    <br><br>

    <% carros.forEach(function(carro) { %>

        <div class="post">

            <h2>
                <%= carro.db_marca %>
                -
                <%= carro.db_modelo %>
            </h2>

            <p>
                Ano:
                <%= carro.db_ano %>
            </p>

            <p>
                Quantidade:
                <%= carro.db_qtde_disponivel %>
            </p>

            <a
                class="botao"
                href="/atualizar_carro/<%= carro._id %>"
            >
                Atualizar
            </a>

            <a
                class="botao"
                href="/remover_carro/<%= carro._id %>"
            >
                Remover
            </a>

        </div>

    <% }) %>

</body>
</html>