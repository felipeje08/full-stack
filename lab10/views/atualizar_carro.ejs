<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">

    <title>Atualizar Carro</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">

        <h1>Atualizar Carro</h1>

        <form
            action="/atualizar_carro/<%= carro._id %>"
            method="POST"
        >

            <label>Marca:</label>

            <input
                type="text"
                name="marca"
                value="<%= carro.db_marca %>"
                required
            >

            <label>Modelo:</label>

            <input
                type="text"
                name="modelo"
                value="<%= carro.db_modelo %>"
                required
            >

            <label>Ano:</label>

            <input
                type="number"
                name="ano"
                value="<%= carro.db_ano %>"
                required
            >

            <label>Quantidade:</label>

            <input
                type="number"
                name="qtde"
                value="<%= carro.db_qtde_disponivel %>"
                required
            >

            <button type="submit">
                Atualizar
            </button>

        </form>

    </div>

</body>
</html>